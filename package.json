{
  "name": "@audio/amp",
  "version": "1.3.0",
  "type": "module",
  "sideEffects": false,
  "description": "Guitar/bass amplification — umbrella for @audio/amp-* atoms (tube stage, cabinet IR)",
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "audio",
    "dsp",
    "amp",
    "cabinet",
    "guitar"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "engines": {
    "node": ">=18"
  },
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "*.d.ts",
    "audio.js"
  ],
  "scripts": {
    "test": "node test.js",
    "test:all": "npm test --workspaces --if-present && npm test",
    "publish:all": "node ../compile/tools/tested.js && npm publish --workspaces && npm publish",
    "prepublishOnly": "node ../compile/tools/tested.js"
  },
  "dependencies": {
    "@audio/amp-tube": "^1.3.1",
    "@audio/amp-cabinet": "^1.3.2"
  },
  "devDependencies": {
    "tst": "^9.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/amp.git"
  },
  "funding": "https://github.com/sponsors/audiojs",
  "types": "./index.d.ts"
}
